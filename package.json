{
  "name": "unenv-preset-cloudflare",
  "version": "0.0.0",
  "description": "",
  "repository": "unjs/unenv",
  "license": "MIT",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs"
    },
    "./runtime/*": {
      "types": "./runtime/*.d.ts",
      "import": "./runtime/*.mjs"
    }
  },
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "runtime"
  ],
  "scripts": {
    "build": "unbuild",
    "lint": "eslint . && prettier -c src",
    "lint:fix": "automd && eslint --fix . && prettier -w src",
    "prepack": "unbuild",
    "release": "pnpm test && changelogen --release && pnpm publish && git push --follow-tags",
    "test": "pnpm lint && pnpm test:types && pnpm test:workerd",
    "test:types": "tsc --noEmit"
  },
  "dependencies": {
    "unenv": "npm:unenv-nightly@2.0.0-20251124-134829-ab99519"
  },
  "devDependencies": {
    "@types/node": "^22.7.4",
    "changelogen": "^0.6.2",
    "eslint": "^9.39.4",
    "eslint-config-unjs": "^0.6.2",
    "jiti": "^2.6.1",
    "prettier": "^3.8.3",
    "typescript": "^5.9.3",
    "unbuild": "^2.0.0",
    "workerd": "^1.20260418.1",
    "wrangler": "^3.114.17"
  },
  "packageManager": "pnpm@9.15.9"
}
